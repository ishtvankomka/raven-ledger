{
  "//": "Merged into .claude/settings.json by INSTALL_PROMPT step 6. Union with existing hooks; keep project entries. Scripts live in .claude/library/hooks/scripts/ after install.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/library/hooks/scripts/pre-bash-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/library/hooks/scripts/stop-hygiene.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/library/hooks/scripts/precompact-handoff.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/library/hooks/scripts/sessionstart-handoff.sh"
          }
        ]
      }
    ]
  }
}
